# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string.
#
# Local dev, no install needed — run `pnpm exec prisma dev -d` and paste the
# URLs it prints:
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
#
# A system PostgreSQL instead:
#   postgresql://user:password@localhost:5432/impostor_hunt?schema=public
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Scratch database for `prisma migrate dev`. The Prisma dev instance prints it
# as the `STREAM`/TCP shadow URL (`pnpm exec prisma dev ls`), and a system
# Postgres usually needs none — leave it blank there.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Port for the combined Next.js + Socket.IO server.
PORT=3000

# Optional. Natural-language mission wording, via Groq's free tier (open-weight
# models, no card). Without it, missions use the template wording.
# GROQ_API_KEY=
