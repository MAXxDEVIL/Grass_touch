// Impostor Hunt — accounts and match history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  sessions     Session[]
  matches      MatchPlayer[]
}

model Session {
  /// SHA-256 of the session token. The token itself is never stored, so a
  /// database leak cannot be replayed as a login.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// One finished match. Written once, at the whistle, and never updated.
model Match {
  id        String        @id @default(cuid())
  winner    String
  /// Why it ended, in one line, as the players were told.
  reason    String
  endedAt   DateTime      @default(now())
  players   MatchPlayer[]

  @@index([endedAt])
}

/// One player's line in one match. The leaderboard is this table, summed.
model MatchPlayer {
  id      String  @id @default(cuid())
  matchId String
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  points    Int
  /// Catches this player made: survivors caught, or 1 for tagging the impostor.
  catches   Int
  /// Whether they were tagged out during the match.
  caught    Boolean
  /// Their side won. A caught survivor still shares the survivors' win.
  won       Boolean

  @@index([userId])
  @@index([matchId])
}
